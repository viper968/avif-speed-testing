+// EXPERIMENT ONLY (avif-speed-testing): AOM_EXP bit flags enable new,
+// non-upstream search shortcuts so they can be A/B tested without rebuilds.
+//   1: approximate (Laplacian) coefficient rate for luma in MODE_EVAL
+//   2: chroma intra modes pruned by Hadamard model cost (> 1.50x best)
+//   4: same as 2 with a tighter threshold (> 1.25x best)
+static int aom_exp_flags(void) {
+  static int flags = -1;
+  if (flags < 0) {
+    const char *env = getenv("AOM_EXP");
+    flags = env ? (int)strtol(env, NULL, 0) : 0;
+  }
+  return flags;
+}
