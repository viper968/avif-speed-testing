+
+// Quantizes 8 coefficients with quantization matrices. Bit-exact with the
+// qm branch of quantize_fp_helper_c() in av1_quantize.c, but processes
+// coefficients in memory order and derives eob from iscan.
+static inline __m256i quantize_fp_qm_8(
+    const tran_low_t *coeff_ptr, const qm_val_t *qm_ptr,
+    const qm_val_t *iqm_ptr, const int16_t *iscan, __m256i round,
+    __m256i quant, __m256i dequant, __m256i thr, __m128i shift_q,
+    __m128i shift_dq, tran_low_t *qcoeff_ptr, tran_low_t *dqcoeff_ptr,
+    __m256i eob) {
+  const __m256i coeff = _mm256_loadu_si256((const __m256i *)coeff_ptr);
+  const __m256i wt =
+      _mm256_cvtepu8_epi32(_mm_loadl_epi64((const __m128i *)qm_ptr));
+  const __m256i iwt =
+      _mm256_cvtepu8_epi32(_mm_loadl_epi64((const __m128i *)iqm_ptr));
+  // The C code works in int64. Capping |coeff| at 2^20 (unsigned, so INT_MIN
+  // is capped too) keeps every product below in 32 bits without changing the
+  // result: thr < 2^20, and |coeff| + round is clamped to INT16_MAX anyway.
+  const __m256i abs_coeff =
+      _mm256_min_epu32(_mm256_abs_epi32(coeff), _mm256_set1_epi32(1 << 20));
+  // abs_coeff * wt >= thr  <=>  abs_coeff * wt > thr - 1
+  const __m256i mask = _mm256_cmpgt_epi32(_mm256_mullo_epi32(abs_coeff, wt),
+                                          _mm256_sub_epi32(thr, _mm256_set1_epi32(1)));
+  const __m256i a = _mm256_min_epi32(_mm256_add_epi32(abs_coeff, round),
+                                     _mm256_set1_epi32(INT16_MAX));
+  // (a * wt * quant) >> (16 - log_scale + AOM_QM_BITS) needs up to 38 bits:
+  // do it as two 32x32->64 multiplies on the even and odd lanes.
+  const __m256i aw = _mm256_mullo_epi32(a, wt);
+  const __m256i prod_even =
+      _mm256_srl_epi64(_mm256_mul_epu32(aw, quant), shift_q);
+  const __m256i prod_odd = _mm256_srl_epi64(
+      _mm256_mul_epu32(_mm256_srli_epi64(aw, 32), _mm256_srli_epi64(quant, 32)),
+      shift_q);
+  const __m256i tmp = _mm256_and_si256(
+      _mm256_blend_epi32(prod_even, _mm256_slli_epi64(prod_odd, 32), 0xAA),
+      mask);
+  // dequant = (dequant * iwt + (1 << (AOM_QM_BITS - 1))) >> AOM_QM_BITS
+  const __m256i dq = _mm256_srli_epi32(
+      _mm256_add_epi32(_mm256_mullo_epi32(dequant, iwt),
+                       _mm256_set1_epi32(1 << (AOM_QM_BITS - 1))),
+      AOM_QM_BITS);
+  // Matches the C code's 32-bit (wrapping) multiply and arithmetic shift.
+  const __m256i abs_dq = _mm256_sra_epi32(_mm256_mullo_epi32(tmp, dq), shift_dq);
+  _mm256_storeu_si256((__m256i *)qcoeff_ptr, _mm256_sign_epi32(tmp, coeff));
+  _mm256_storeu_si256((__m256i *)dqcoeff_ptr, _mm256_sign_epi32(abs_dq, coeff));
+  // eob = 1 + max(iscan) over nonzero outputs.
+  const __m256i nz = _mm256_xor_si256(
+      _mm256_cmpeq_epi32(tmp, _mm256_setzero_si256()), _mm256_set1_epi32(-1));
+  const __m256i pos = _mm256_add_epi32(
+      _mm256_cvtepi16_epi32(_mm_loadu_si128((const __m128i *)iscan)),
+      _mm256_set1_epi32(1));
+  return _mm256_max_epi32(eob, _mm256_and_si256(pos, nz));
+}
+
+void av1_quantize_fp_qm_avx2(const tran_low_t *coeff_ptr, intptr_t n_coeffs,
+                             const int16_t *round_ptr, const int16_t *quant_ptr,
+                             tran_low_t *qcoeff_ptr, tran_low_t *dqcoeff_ptr,
+                             const int16_t *dequant_ptr, uint16_t *eob_ptr,
+                             const int16_t *scan, const int16_t *iscan,
+                             const qm_val_t *qm_ptr, const qm_val_t *iqm_ptr,
+                             int log_scale) {
+  (void)scan;
+  assert(n_coeffs % 8 == 0);
+  const int r_dc = ROUND_POWER_OF_TWO(round_ptr[0], log_scale);
+  const int r_ac = ROUND_POWER_OF_TWO(round_ptr[1], log_scale);
+  const int thr_shift = AOM_QM_BITS - (1 + log_scale);
+  const __m128i shift_q = _mm_cvtsi32_si128(16 - log_scale + AOM_QM_BITS);
+  const __m128i shift_dq = _mm_cvtsi32_si128(log_scale);
+  // First 8 coefficients: lane 0 is DC, the rest are AC.
+  __m256i round = _mm256_setr_epi32(r_dc, r_ac, r_ac, r_ac, r_ac, r_ac, r_ac, r_ac);
+  __m256i quant = _mm256_setr_epi32(quant_ptr[0], quant_ptr[1], quant_ptr[1],
+                                    quant_ptr[1], quant_ptr[1], quant_ptr[1],
+                                    quant_ptr[1], quant_ptr[1]);
+  __m256i dequant = _mm256_setr_epi32(
+      dequant_ptr[0], dequant_ptr[1], dequant_ptr[1], dequant_ptr[1],
+      dequant_ptr[1], dequant_ptr[1], dequant_ptr[1], dequant_ptr[1]);
+  __m256i thr = _mm256_setr_epi32(
+      dequant_ptr[0] << thr_shift, dequant_ptr[1] << thr_shift,
+      dequant_ptr[1] << thr_shift, dequant_ptr[1] << thr_shift,
+      dequant_ptr[1] << thr_shift, dequant_ptr[1] << thr_shift,
+      dequant_ptr[1] << thr_shift, dequant_ptr[1] << thr_shift);
+  __m256i eob = _mm256_setzero_si256();
+  for (intptr_t i = 0; i < n_coeffs; i += 8) {
+    eob = quantize_fp_qm_8(coeff_ptr + i, qm_ptr + i, iqm_ptr + i, iscan + i,
+                           round, quant, dequant, thr, shift_q, shift_dq,
+                           qcoeff_ptr + i, dqcoeff_ptr + i, eob);
+    if (i == 0) {
+      round = _mm256_set1_epi32(r_ac);
+      quant = _mm256_set1_epi32(quant_ptr[1]);
+      dequant = _mm256_set1_epi32(dequant_ptr[1]);
+      thr = _mm256_set1_epi32(dequant_ptr[1] << thr_shift);
+    }
+  }
+  __m128i m = _mm_max_epi32(_mm256_castsi256_si128(eob),
+                            _mm256_extracti128_si256(eob, 1));
+  m = _mm_max_epi32(m, _mm_shuffle_epi32(m, 0x4E));
+  m = _mm_max_epi32(m, _mm_shuffle_epi32(m, 0xB1));
+  *eob_ptr = (uint16_t)_mm_cvtsi128_si32(m);
+}
